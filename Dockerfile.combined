# Base image fetch is the only network access needed by this build.
ARG BUN_IMAGE=oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13@sha256:d74d144baa124dd9defd01d71872bb56c49d4441dba6153ccf790364f97e64b1
FROM ${BUN_IMAGE} AS dependency-assets
WORKDIR /source
COPY scripts/vendor-dependencies.ts scripts/
COPY vendor/ vendor/
COPY backend/package.json backend/bun.lock backend/
COPY frontend/package.json frontend/bun.lock frontend/

FROM dependency-assets AS frontend-builder
RUN --network=none bun scripts/vendor-dependencies.ts install frontend
COPY frontend/ frontend/
ARG APP_VERSION=unknown
RUN --network=none cd frontend && APP_VERSION=${APP_VERSION} bun run build

FROM dependency-assets AS backend-dependencies
RUN --network=none bun scripts/vendor-dependencies.ts install backend --production

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=5001 PATH=/usr/local/bin:/usr/bin:/bin
USER 0
COPY --from=dependency-assets /usr/local/bin/bun /usr/local/bin/bun
COPY --from=backend-dependencies /source/backend/node_modules ./node_modules
COPY backend/package.json backend/bun.lock ./
COPY backend/src ./src
COPY --from=frontend-builder /source/frontend/dist ./public
# Sharp uses its prebuilt libvips; HEIC decoding uses heic-convert's WASM.
RUN --network=none ["/usr/local/bin/bun", "-e", "require(\"node:fs\").mkdirSync(\"/app/data/cover-art\",{recursive:true}); const sharp = require(\"sharp\"); await sharp({create:{width:1,height:1,channels:3,background:\"red\"}}).jpeg().toBuffer(); if(typeof require(\"heic-convert\") !== \"function\") throw new Error(\"Missing HEIC converter\"); console.log(\"Image codecs loaded\", sharp.versions.vips);"]
EXPOSE 5001
ENTRYPOINT ["/usr/local/bin/bun"]
CMD ["src/start.ts"]
