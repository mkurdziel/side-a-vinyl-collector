{
  "name": "side-a-vinyl-collector-backend",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "migrate": "bun src/db/migrate.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/heic-convert": "^2.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.5",
    "vite": "^8.3.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/adm-zip": "^0.6.0",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^6.0.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
